Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04

%environment
    export MUJOCO_GL=osmesa
    export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
    export MUJOCO_PY_MUJOCO_PATH=/fakeroot/.mujoco/mujoco210
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/fakeroot/.mujoco/mujoco210/bin

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update

    apt-get install -y \
        build-essential \
        cmake \
        curl \
        libgl1-mesa-dev \
        libwayland-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxkbcommon-dev \
        libxrandr-dev \
        libxi-dev \
        ninja-build \
        git \
        pkg-config \
        vim \
        wget \
        libglew-dev \
        python3.8 \
        python3.8-dev \
        python3-pip \
        patchelf

    apt clean
    apt autoremove -y
    apt update

    git clone https://github.com/kracka731/RBE577_MachineLearning_Projects.git /workspace

    cd /workspace/Project_4/Slurm
    git checkout turing_kasia
    pip install -r pip_reqs_froze.txt

    cd ../..

    pip install mujoco-py "Cython<3" mujoco==3.2.3

    pip install torch==2.0.0 torchvision==0.15.0 torchaudio==2.0.0 \
        --index-url https://download.pytorch.org/whl/cu118

    cd /workspace/Project_4
    git submodule update --init --recursive

    cd submodules/robosuite
    pip install -r requirements-extra.txt

    cd ../robomimic
    pip install -e .

    cd 
    ls -a


    mkdir -p /fakeroot/.mujoco
    curl -L https://github.com/deepmind/mujoco/releases/download/2.1.0/mujoco210-linux-x86_64.tar.gz \
        -o /fakeroot/.mujoco/mujoco210.tar.gz
    tar -xzf /fakeroot/.mujoco/mujoco210.tar.gz -C /fakeroot/.mujoco/
    rm /fakeroot/.mujoco/mujoco210.tar.gz

%runscript
    exec /bin/bash