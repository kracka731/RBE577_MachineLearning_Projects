Bootstrap: docker
From: nvidia/cuda:12.1.0-cudnn8-devel-ubuntu20.04

%environment
    export MUJOCO_GL=osmesa
    export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
    export MUJOCO_PY_MUJOCO_PATH=/fakeroot/.mujoco/mujoco210

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update

    apt-get install -y \
        build-essential \
        cmake \
        curl \
        libgl1-mesa-dev \
        libwayland-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxkbcommon-dev \
        libxrandr-dev \
        libxi-dev \
        ninja-build \
        git \
        pkg-config \
        vim \
        wget \
        libglew-dev \
        python3.8 \
        python3.8-dev \
        python3-pip \
        patchelf

    pip3 install --upgrade pip

    pip3 install torch==2.0.0 torchvision==0.15.0 torchaudio==2.0.0 \
        --index-url https://download.pytorch.org/whl/cu121

    pip3 install robosuite mujoco-py "Cython<3"

    git clone https://github.com/kracka731/RBE577_MachineLearning_Projects.git /workspace

    cd /workspace/Project_4
    git submodule update --init --recursive

    cd submodules/robosuite
    pip3 install -e .
    pip3 install -r requirements-extra.txt

    cd ../robomimic
    pip3 install -e .

    cd /workspace/Project_4

    curl https://mujoco.org/download/mujoco210-linux-x86_64.tar.gz -o mujoco210.tar.gz
    mkdir -p /fakeroot/.mujoco
    tar -xf mujoco210.tar.gz -C /fakeroot/.mujoco

%runscript
    exec /bin/bash